    "type": "git",
    "url": "https://github.com/yuhr/use-await-data.git"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@testing-library/react-hooks": "^7.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^17.0.2",
    "eclint": "^2.8.1",
    "husky": "^7.0.1",
    "jest": "^29.7.0",
    "lint-staged": "^11.0.1",
    "microbundle": "0.15.1",
    "prettier": "npm:@yuhr/prettier@^2.2.1",
    "react": "^17.0.2",
    "react-test-renderer": "^17.0.2",
    "semantic-release": "^17.4.4",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },

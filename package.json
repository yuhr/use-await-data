{
  "name": "use-await-data",
  "version": "0.0.0",
  "description": "A React hook that executes an async task to populate the desired data.",
  "type": "module",
  "sideEffects": false,
  "source": "./src/index.ts",
  "main": "./dst/index.cjs",
  "module": "./dst/index.module.js",
  "types": "./dst/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "default": "./dst/index.module.js",
        "types": "./dst/index.d.ts"
      },
      "require": {
        "default": "./dst/index.cjs",
        "types": "./dst/index.d.ts"
      }
    }
  },
  "files": [
    "dst"
  ],
  "scripts": {
    "build": "microbundle",
    "prepack": "npm run build",
    "prepare": "husky install",
    "test": "jest",
    "watch": "jest --watch --detectOpenHandles",
    "release": "semantic-release --branches release"
  },
  "keywords": [
    "react",
    "hooks",
    "async",
    "await",
    "promise"
  ],
  "author": "Yu Shimura <mail@yuhr.org>",

{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "target": "esnext",
    "module": "nodenext",
    "esModuleInterop": true,
    "outDir": "dst",
    "rootDir": "src"
  }
}